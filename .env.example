# APEXODDS environment — copy to .env (gitignored) and fill in.
# Everything is optional: the whole Phase 0 pipeline runs offline from
# parquet with the defaults.

# Local data lake root (default: ./data)
#APEXODDS_DATA_DIR=data
#APEXODDS_FASTF1_CACHE=data/fastf1_cache
#APEXODDS_REPORTS_DIR=reports

# Supabase Postgres connection string (Dashboard → Connect → URI).
# Needed only for `python -m apexodds.data.db --init/--load`.
#SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# API base URLs (defaults are fine)
#OPENF1_BASE_URL=https://api.openf1.org/v1
#JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
